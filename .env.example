# ---------- MAIN SERVER (your central profile + petition server) ----------
MAIN_PORT=4000
# Long random secret used to sign login tokens (auto-generated into data/.token_secret if empty)
TOKEN_SECRET=
# Comma-separated keys that community game servers use to talk to the main server
SERVER_KEYS=change-me-server-key
# Secret for external survey tools (Google Forms / Typeform / Jotform) posting signatures
WEBHOOK_KEY=change-me-webhook-key
# Admin key for CSV export, moderation, bans and season reset
ADMIN_KEY=change-me-admin-key

# ---------- GAME SERVER (each community runs their own) ----------
GAME_PORT=3000
SERVER_NAME=Gadigal Community Server
MAIN_SERVER_URL=http://localhost:4000
# Public URL of the main server (used for petition share links)
MAIN_PUBLIC_URL=http://localhost:4000
# Must match one of SERVER_KEYS on the main server
SERVER_KEY=change-me-server-key
# WebRTC ICE servers for stage live-streaming (add a TURN server for players behind strict NATs)
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# DEV=1 enables chat cheat commands (/sigs, /sup, /reset, /red, /tp) — never use in production
DEV=0

# ---------- Wathaga survey -> petition signatures (main server) ----------
# Pulls individual responses from a Wathaga survey; each "Yes" response becomes a signature.
WATHAGA_SURVEY_ID=
WATHAGA_REF=
WATHAGA_POLL_SECONDS=60
# Key with "Read summaries" + "Read individual rows" + "Send data in" (Wathaga: API & integrations)
WATHAGA_API_KEY=
